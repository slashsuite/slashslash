---
import { appShellRootClassFor, colourSchemeScript } from "@slashsuite/ui-react";
import { thisBuildCommit } from "#/content/build-commit";
import { OG_HEIGHT, OG_WIDTH, ogCardFor } from "#/content/og";
import { SITE_NAME, SITE_URL } from "#/content/site";
import { SECTIONS, type SectionKey } from "#/shell/sections";
import { HYDRATED_SCRIPT } from "#/shell/island";
import { SlashShell } from "#/shell/SlashShell";
import "#/styles.css";

interface Props {
  /** The page's section: its theme pair, its mark and, for a tool, its row of pages. */
  section: SectionKey;
  /** The page title. */
  title: string;
  /** What the page says about itself to a search engine and a link preview. */
  description?: string | undefined;
}

const { section, title, description } = Astro.props;
const { day: light, night: dark, mark } = SECTIONS[section];
// The page's own address on the live site, with no trailing slash.
const path =
  Astro.url.pathname
    .replace(/\.html$/, "")
    .replace(/(^|\/)index$/, "")
    .replace(/\/+$/, "") || "/";
// The page's own share card (the suite's on the 404 page), as an absolute URL: link previews in chat apps want one.
const card = ogCardFor(path);
const shareImage = `${SITE_URL}/og/${card.slug}.png`;

const classes = JSON.stringify({ light, dark });
// Before first paint. colourSchemeScript reads the stored choice (else the system's) and knows only the
// `dark` class; this then swaps that for the section's own scope, so <html> carries exactly one of them.
const scopeScript = `${colourSchemeScript};(function(c){var r=document.documentElement,d=r.classList.contains("dark");r.classList.remove("dark");r.classList.toggle(c.light,!d);r.classList.toggle(c.dark,d)})(${classes})`;
// The kit's toggle is static HTML here, so this does what its click handler would: switch the scope,
// set color-scheme and store the choice under the kit's key, which every section's head script reads.
const toggleScript = `(function(c){document.querySelectorAll("[data-scheme-toggle]").forEach(function(b){b.addEventListener("click",function(){var r=document.documentElement,d=!r.classList.contains(c.dark);r.classList.toggle(c.dark,d);r.classList.toggle(c.light,!d);r.style.colorScheme=d?"dark":"light";try{localStorage.setItem("hackcove:colour-scheme",d?"dark":"light")}catch(e){}})})})(${classes})`;
---

<html lang="en" class={appShellRootClassFor("light", { light, dark })}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="build-commit" content={thisBuildCommit()} />
    <title>{`${title} | ${SITE_NAME}`}</title>
    {description !== undefined && <meta name="description" content={description} />}
    <link rel="canonical" href={`${SITE_URL}${path}`} />
    <link rel="icon" href={mark} type="image/svg+xml" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={card.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <!-- Before first paint: the visitor's stored choice, else the system's light or dark. No cookie. -->
    <script is:inline set:html={scopeScript} />
    <!-- A page's own before-paint script (the home's motion guard). -->
    <slot name="head" />
  </head>
  <body>
    <SlashShell section={section} path={path}>
      {Astro.slots.has("controls") && <slot name="controls" slot="controls" />}
      <slot />
    </SlashShell>
    <script is:inline set:html={toggleScript} />
    <!-- Last in <body>: marks <html data-hydrated> once every eager island has hydrated. -->
    <script is:inline set:html={HYDRATED_SCRIPT} />
  </body>
</html>
