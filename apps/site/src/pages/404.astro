---
// The design system's not-found body, with a link home, on the shell in the suite's section. The
// shell's main is full width (for a hero's ground), so the body sits in the kit's Container.
import { Container, NotFound } from "@slashsuite/ui-react";
import Slash from "#/layouts/Slash.astro";
---

<Slash section="suite" title="Page not found">
  <div class="hero-ground">
    <Container>
      <NotFound />
    </Container>
  </div>
</Slash>
