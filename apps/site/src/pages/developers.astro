---
// /developers on the shell, in the suite's section: hands-on quick-start commands for every built product,
// self-hosting in one container, every product in detail with its licence line, and the ask. Today and
// SelfHost hydrate when they scroll into view for their CodeBlock copy buttons; nothing else runs in the browser.
import { type FactsProduct, licenceLine } from "#/content/facts";
import { DEVELOPERS_DESCRIPTION, DEVELOPERS_TITLE } from "#/content/site";
import { Ask } from "#/developers/ask";
import { Intro } from "#/developers/intro";
import { SelfHost } from "#/developers/self-host";
import { Today } from "#/developers/today";
import { ToolsInDetail } from "#/developers/tools";
import Slash from "#/layouts/Slash.astro";

const LICENCES: Record<FactsProduct, string> = {
  omnislash: licenceLine("omnislash"),
  uislash: licenceLine("uislash"),
  taskslash: licenceLine("taskslash"),
  flakeslash: licenceLine("flakeslash"),
  pixelslash: licenceLine("pixelslash"),
  toggleslash: licenceLine("toggleslash"),
};
---

<Slash section="suite" title={DEVELOPERS_TITLE} description={DEVELOPERS_DESCRIPTION}>
  <Intro />
  <Today client:visible />
  <SelfHost client:visible />
  <ToolsInDetail licences={LICENCES} />
  <Ask />
</Slash>
