---
// The suite home, on the shell in the suite's section: the hero and the pipeline of tools, then where it
// stands and the ask. The hero's motion guard runs before first paint; the Motion island is the only
// thing on the page that hydrates.
import { HERO } from "#/content/story";
import { Home } from "#/home/home";
import { Stands, YourView } from "#/home/sections";
import { Motion, MOTION_SCRIPT } from "#/illustrations/motion";
import Slash from "#/layouts/Slash.astro";
---

<Slash section="suite" title={HERO.title.text} description={HERO.description.text}>
  <script is:inline slot="head" set:html={MOTION_SCRIPT} />
  <Home />
  <Stands />
  <YourView />
  <Motion client:load />
</Slash>
