---
// /pixelslash/pricing: the PixelSlash pricing page on the shell, in the PixelSlash section.
import { Container } from "@slashsuite/ui-react";
import Slash from "#/layouts/Slash.astro";
import { PricingPage } from "#/pixelslash/pages/pricing";
import { psPage } from "#/pixelslash/page";

const page = psPage("/pricing");
---

<Slash section="pixelslash" title={page.title} description={page.description}>
  <div class="py-8">
    <Container>
      <PricingPage />
    </Container>
  </div>
</Slash>
