---
// /pixelslash/self-host: PixelSlash's apps/web/SELF-HOST.md, fetched at the pinned commit and rendered at build time on the shell.
import { Container } from "@slashsuite/ui-react";
import Slash from "#/layouts/Slash.astro";
import { DocPage } from "#/pixelslash/doc/DocPage";
import { SELF_HOST_DOC, docPage } from "#/pixelslash/doc/docs";

const page = docPage(SELF_HOST_DOC);
---

<Slash section="pixelslash" title={page.title} description={page.description}>
  <div class="py-8">
    <Container>
      <DocPage doc={SELF_HOST_DOC} />
    </Container>
  </div>
</Slash>
