---
// /uislash/<slug>: one component page from the pinned uislash docs data and stories.
import type { GetStaticPaths } from "astro";
import { Container, copyScript } from "@slashsuite/ui-react";
import { componentPageOf, componentPages } from "@uislash-src/packages/ui-react/docs/components/index";
import Slash from "#/layouts/Slash.astro";
import { ComponentPage, contentsOf, neighbourLinksOf } from "#/uislash/ComponentPage";
import { DocsFrame } from "#/uislash/DocsFrame";
import { SearchIsland } from "#/uislash/SearchIsland";
import { UISLASH_SEARCH_ITEMS } from "#/uislash/search";

export const getStaticPaths = (() =>
  componentPages.map((page) => ({ params: { slug: page.slug } }))) satisfies GetStaticPaths;

const { slug } = Astro.params;
const page = componentPageOf(slug);
const plainSummary = page.summary.replaceAll("`", "");
const description =
  plainSummary.length >= 40 ? plainSummary : `${page.name} component in UISlash: ${plainSummary}`;
const neighbours = neighbourLinksOf(page);
---

<Slash section="uislash" title={`${page.name} · UISlash`} description={description}>
  <script slot="head" is:inline set:html={copyScript} />
  <SearchIsland slot="controls" client:load label="Search components" items={UISLASH_SEARCH_ITEMS} />
  <div class="py-8">
    <Container>
      <DocsFrame
        client:load
        pathname={Astro.url.pathname}
        title={page.name}
        description={page.summary}
        contents={contentsOf(page)}
        previous={neighbours.previous}
        next={neighbours.next}
      >
        <ComponentPage page={page} />
      </DocsFrame>
    </Container>
  </div>
</Slash>
