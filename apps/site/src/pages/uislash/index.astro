---
// /uislash: UISlash Getting started and component directory, in the Slash shell.
import { Container, SiteSearch, copyScript } from "@slashsuite/ui-react";
import Slash from "#/layouts/Slash.astro";
import { DocsFrame } from "#/uislash/DocsFrame";
import { UISLASH_SEARCH_ITEMS } from "#/uislash/search";
import { UiPage } from "#/uislash/UiPage";
import { UISLASH_UI } from "#/uislash/ui";
---

<Slash section="uislash" title="UISlash" description={UISLASH_UI.subtitle}>
  <script slot="head" is:inline set:html={copyScript} />
  <SiteSearch slot="controls" client:load label="Search components" items={UISLASH_SEARCH_ITEMS} />
  <div class="py-8">
    <Container>
      <DocsFrame client:load pathname={Astro.url.pathname} title="UISlash" description={UISLASH_UI.subtitle}>
        <UiPage />
      </DocsFrame>
    </Container>
  </div>
</Slash>
